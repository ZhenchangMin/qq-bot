# Copy this file to .env and fill in local secrets. Never commit .env.
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
BOT_NAME=QQBot

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT=60
# Recommended for low-latency chat with DeepSeek V4. Set empty for providers
# that do not support DeepSeek's `thinking` request field.
LLM_THINKING=disabled

LLM_PRIVATE_MAX_TURNS=8
LLM_GROUP_MAX_TURNS=4
LLM_PRIVATE_MAX_TOKENS=900
LLM_GROUP_MAX_TOKENS=350
LLM_PRIVATE_MAX_INPUT_CHARS=12000
LLM_GROUP_MAX_INPUT_CHARS=4000

# Runtime safety
BOT_INSTANCE_LOCK_PORT=38451
MESSAGE_DEDUPE_TTL_SECONDS=600
MESSAGE_DEDUPE_MAX_IDS=4096
